AC_INIT(src/heroes.c)
AM_INIT_AUTOMAKE(heroes, 0.5)

AC_CANONICAL_HOST
AC_DEFINE_UNQUOTED(HOST,"$host",[The canonical host])

# ==================
# Supported options.
# ==================

AC_ARG_ENABLE(sound,
[  --disable-sound         Turn off sound support])
AC_ARG_ENABLE(debug,
[  --enable-debug          Turn on debugging],[
AC_DEFINE(DEBUG,1,[Define if you want debuging code])])
AC_ARG_ENABLE(mem-debug,
[  --enable-mem-debug      Turn on memory debugging])
AC_ARG_ENABLE(user-config,
[  --disable-user-config   Turn off per user configuration file])
AC_ARG_ENABLE(user-scores,
[  --disable-user-scores   Turn off per user scores file])
AC_ARG_ENABLE(user-saves,
[  --disable-user-saves    Turn off per user saves file])
AC_ARG_ENABLE(joystick,
[  --disable-joystick      Turn off joystick support])
AC_ARG_WITH(sdl,
[  --with-sdl[=DIR]        Root directory of SDL installation
  --without-sdl           Disables SDL usage completely])


# --with-sdl-exec-prefix should imply --with-sdl, and vice-versa

test "${with_sdl_exec_prefix-no}" != no &&
 test "${with_sdl-yes}" = yes && with_sdl=$with_sdl_exec_prefix

test "${with_sdl-yes}" != yes &&
 test "${with_sdl_exec_prefix-yes}" = yes && with_sdl_exec_prefix=$with_sdl

# handle choice between GGI and SDL

if test "${with_GGI-no}" != no; then
  if test "${with_sdl-no}" != no; then
    echo ${with_GGI} ${with_sdl}
    AC_MSG_ERROR(GGI and SDL can't be both used.)
  fi
  # disable SDL if GGI was selected
  with_sdl=no
else
  if test "${with_sdl-no}" != no; then
    # disable GGI if SDL was selected
    with_GGI=no
  fi
fi

# Detect wether CFLAGS and LDFLAGS will be setup by autoconf or not.
test -z "${CFLAGS+set}"  && CFLAGS=  auto_cflags=1
test -z "${LDFLAGS+set}" && LDFLAGS= auto_ldflags=1

# These value will be updated according to detections.
display_lib='<disabled>'
joystick_lib='<disabled>'
sound_lib='<disabled>'
malloc_lib='<disabled>'

# ===================
# Check for programs.
# ===================

AC_PROG_CC

AC_PROG_CPP
AC_PROG_AWK

usable_perl=false
AC_PATH_PROG(PERL, perl)
if test \! -z "$PERL"; then
  AC_MSG_CHECKING(perl version)
  if $PERL -e 'printf "%g\n", $]; exit($] >= 5.004);'; then
    AC_MSG_WARN([perl 5.004 needed])
  else
    usable_perl=true 
  fi
fi
AM_CONDITIONAL(USABLE_PERL, test x$usable_perl = xtrue)

AC_PATH_PROG(HELP2MAN, help2man)
AM_CONDITIONAL(HAVE_HELP2MAN, test \! -z "$HELP2MAN")

AC_CACHE_SAVE

# =====================
# Checks for libraries.
# =====================

# ==============
# Check for GGI.
# ==============

if test "${with_GGI-yes}" != no; then

AC_caolan_CHECK_PACKAGE(GGI,ggiOpen,ggi,ggi/ggi.h,,[echo "============
I could not link with GGI.  
Please check if it is correctly installed.
A link to the GGI homepage is given in the README file."; 
with_GGI=no])

fi
if test "${with_GGI-yes}" != no; then

# Where is <ggi/keyboard.h> located?
# (Adapted from Zsh's configure.in)
AC_CACHE_CHECK(where ggi/keyboard.h is located, path_ggi_keyboard_h,
[# Look at the output from the preprocessor.
# We should get lines of the form `# 1 "/usr/include/ggi/keyboard.h"'
# The backslash substitution is to persuade cygwin to cough up
# slashes rather than doubled backslashes in the path.
echo "#include <ggi/keyboard.h>" > nametmp.c
keyfile_list="`$CPP nametmp.c |
sed -n 's/^#[ 	].*\"\(.*\)\"/\1/p' |
sed 's/\\\\\\\\/\//g' |
$AWK '{ if (\$1 ~ \"ggi/keyboard.h\") files[[\$1]] = \$1 }
  END { for (var in files) print var }'`"
rm -f nametmp.c
if test -z "$keyfile_list"; then
  # In case we don't get the stuff from the preprocesor, use the old
  # list of standard places.
  keyfile_list="/usr/include/ggi/keyboard.h
${GGI_include-/usr/local/include}/ggi/keyboard.h
/dev/null"
fi
for KEY_H in $keyfile_list
do
  # Try to make sure it doesn't get confused by files that don't
  # have real keysyms definitions in
  nkeys=`test -f $KEY_H && \
  grep '#[ 	]*define[ 	][ 	]*GIIUC*' $KEY_H | \
  wc -l | sed 's/[ 	]//g'`
  test "x$nkeys" != x && test "$nkeys" -ge 7 && break
done
if test $KEY_H = "/dev/null"; then
  AC_MSG_ERROR(Keysyms macros not found: where is GGI installed?)
fi
path_ggi_keyboard_h=$KEY_H
])
GGI_KEYBOARD_H=$path_ggi_keyboard_h
AC_SUBST(GGI_KEYBOARD_H)

with_sdl=no
display_lib=LibGGI
fi

# ==================
# Check for lib SDL.
# ==================

if test "${with_sdl-yes}" != no; then

AC_PATH_GENERIC(sdl,1.0.1,[
CFLAGS="$SDL_CFLAGS $CFLAGS"
LIBS="$SDL_LIBS $LIBS"
AC_DEFINE(HAVE_SDL,1,[Define if you have the SDL library])
],[echo "============
I could not find SDL.  
Please check if it is correctly installed.
A link to the SDL homepage is given in the README file.";
with_sdl=no])

fi
if test "${with_sdl-yes}" != no; then

# Where is <SDL_keysym.h> located?
# (Adapted from Zsh's configure.in)
AC_CACHE_CHECK(where SDL_keysym.h is located, path_sdl_keysym_h,
[# Look at the output from the preprocessor.
# We should get lines of the form `# 1 "/usr/include/SDL/SDL_keysym.h"'
# The backslash substitution is to persuade cygwin to cough up
# slashes rather than doubled backslashes in the path.
echo "#include <SDL_keysym.h>" > nametmp.c
keyfile_list="`$CPP $SDL_CFLAGS nametmp.c |
sed -n 's/^#[ 	].*\"\(.*\)\"/\1/p' |
sed 's/\\\\\\\\/\//g' |
$AWK '{ if (\$1 ~ \"SDL_keysym.h\") files[[\$1]] = \$1 }
  END { for (var in files) print var }'`"
rm -f nametmp.c
if test -z "$keyfile_list"; then
  # In case we don't get the stuff from the preprocesor, use the old
  # list of standard places.
  keyfile_list="/usr/include/SDL/SDL_keysym.h
/usr/local/include/SDL/SDL_keysym.h
/dev/null"
fi
for KEY_H in $keyfile_list
do
  # Try to make sure it doesn't get confused by files that don't
  # have real keysyms definitions in
  nkeys=`test -f $KEY_H && \
  grep '#[ 	]*define[ 	][ 	]*SDLK_*' $KEY_H | \
  wc -l | sed 's/[ 	]//g'`
  test "x$nkeys" != x && test "$nkeys" -ge 7 && break
done
if test $KEY_H = "/dev/null"; then
  AC_MSG_ERROR(Keysyms definitions not found: where is SDL installed?)
fi
path_sdl_keysym_h=$KEY_H
])
SDL_KEYSYM_H=$path_sdl_keysym_h
AC_SUBST(SDL_KEYSYM_H)
display_lib="SDL dnl
$sdl_config_major_version.$sdl_config_minor_version.$sdl_config_micro_version"
AC_CHECK_FUNCS(SDL_EnableKeyRepeat)
fi

# ================================================
# Check that either LibGGI or SDL have been found.
# ================================================

if test x${with_sdl} = xno && test x${with_GGI} = xno; then
  AC_MSG_ERROR(Either GGI or SDL should be made available to heroes.)
fi
AM_CONDITIONAL(GGI, test "${with_GGI-yes}" = yes)
AM_CONDITIONAL(SDL, test "${with_sdl-yes}" = yes)

# =================
# Joystick support.
# =================

if test "${enable_joystick-yes}" = yes; then

  # -- check for Joystick support in SDL
  
  sdl_joystick=no
  if test "${with_sdl-yes}" != no && test "${with_GII-no}" = no;  then
    AC_CHECK_FUNCS(SDL_JoystickOpen,[
sdl_joystick=yes
joystick_lib="SDL dnl
$sdl_config_major_version.$sdl_config_minor_version.$sdl_config_micro_version"
])
  fi

  # -- check for LibGGI (another way to get joystick support)

  gii_joystick=no
  if test $sdl_joystick = no && test "${with_GII-yes}" != no;  then
    AC_caolan_CHECK_PACKAGE(GII,giiOpen,gii,ggi/gii.h,[
gii_joystick=yes
joystick_lib='LibGII'
])
  fi

  if test $sdl_joystick = no && test $gii_joystick = no; then
    enable_joystick=no
  fi
fi

if test "${enable_joystick-yes}" = yes; then
  AC_DEFINE(JOYSTICK_SUPPORT,1,[Define if you want joystick support])
fi

# ===================
# Check for lib math.
# ===================

AC_CHECK_LIB(m,sin)

# ====================
# Check for LibMikMod.
# ====================

musicdir=""
if test "${enable_sound-yes}" != no; then
AC_PATH_GENERIC(libmikmod,3.1.7,[
CFLAGS="$LIBMIKMOD_CFLAGS $CFLAGS"
LIBS="$LIBMIKMOD_LIBS $LIBS"
musicdir="mod sfx"
sound_lib="libmikmod dnl
$libmikmod_config_major_version.$libmikmod_config_minor_version.dnl
$libmikmod_config_micro_version"
]AC_DEFINE(HAVE_LIBMIKMOD,1,[Define if you have the LibMikMod library]))
fi
AC_SUBST(musicdir)
AM_CONDITIONAL(NOSOUND, test "x${musicdir}" = x)

# ==================
# Check for dmalloc.
# ==================

mallocdbg='';

if test "x${enable_mem_debug}" = xyes; then
  AC_CHECK_LIB(dmalloc,malloc,[mallocdbg='dmalloc'; 
malloc_lib='dmalloc'; LIBS="-ldmalloc $LIBS";
AC_DEFINE(HAVE_DMALLOC,1,[Define if you link with the dmalloc library])])
fi

# =========================
# Check for electric fence.
# =========================

if test "x${enable_mem_debug}" = xyes; then
  if test "x${mallocdbg}" = x; then
    AC_CHECK_LIB(efence,malloc,[mallocdbg='efence'; 
malloc_lib='electric fence'; LIBS="-lefence $LIBS"])
  fi
fi

# ========================
# Checks for header files.
# ========================

AC_HEADER_DIRENT
AC_HEADER_STDC
AC_CHECK_HEADERS(sys/time.h)

# ==============================================================
# Checks for typedefs, structures, and compiler characteristics.
# ==============================================================

AM_C_PROTOTYPES
AC_C_CONST

# =============================
# Checks for library functions.
# =============================

AC_CHECK_FUNCS(mkdir strdup strstr)

# =====================
# Checks for endianess.
# =====================

AC_C_BIGENDIAN

# =============================================================
# Setup the correct compiler options whether the
# user enabled debug or not.  (Adapted from Zsh's configure.in)
# =============================================================

if test "x${enable_debug}" != xyes && test -n "$GCC"; then
  CFLAGS="$CFLAGS -DNDEBUG"
fi

if test -n "$auto_cflags"; then
  if test "x${enable_debug}" = xyes; then
    if test -n "$GCC"; then
      CFLAGS="$CFLAGS -Wall -W -Wmissing-prototypes -ggdb"
    else
      CFLAGS="$CFLAGS -g"
    fi
  else
    if test -n "$GCC"; then
      CFLAGS="$CFLAGS -ffast-math -fstrict-aliasing -fomit-frame-pointer -O3"
    else
      CFLAGS="$CFLAGS -O"
    fi
  fi
fi
if test -n "$auto_ldflags"; then
  case "${enable_debug}$host_os" in
    yesaix*|yeshpux*|yesnetbsd*) ;;  # "ld -g" is not valid on these systems
    yes*)    LDFLAGS=-g ;;
    *)       LDFLAGS=-s ;;
  esac
fi

# =========================
# Directories configuration
# =========================

user_dir=no
if test "${enable_user_scores-yes}" != no; then
  AC_DEFINE(USER_SCORES_FILE)
fi
if test "${enable_user_config-yes}" != no; then
  AC_DEFINE(USER_CONFIG_FILE)
fi
if test "${enable_user_saves-yes}" != no; then
  AC_DEFINE(USER_SAVES_FILE)
fi

confdir=${datadir}/heroes/txt_cfg/
extradir=${datadir}/heroes/extralvl/
heddir=${datadir}/heroes/hedit/
introdir=${datadir}/heroes/intro/
moddir=${datadir}/heroes/mod/
nivdir=${datadir}/heroes/level/
rscdir=${datadir}/heroes/rsc/
scoresdir=${datadir}/heroes/txt_cfg/
sfxdir=${datadir}/heroes/sfx/
spritedir=${datadir}/heroes/sprites/
textdir=${datadir}/heroes/txt_cfg/
etcdir=${datadir}/heroes/etc/

AC_SUBST(confdir)
AC_SUBST(extradir)
AC_SUBST(heddir)
AC_SUBST(introdir)
AC_SUBST(moddir)
AC_SUBST(nivdir)
AC_SUBST(rscdir)
AC_SUBST(scoresdir)
AC_SUBST(sfxdir)
AC_SUBST(spritedir)
AC_SUBST(textdir)
AC_SUBST(etcdir)

AC_DEFINE_DIR(confdir  ,confdir,  config directory)
AC_DEFINE_DIR(extradir ,extradir, extra levels directory)
AC_DEFINE_DIR(heddir   ,heddir,   editor data directory)
AC_DEFINE_DIR(introdir ,introdir, intro data directory)
AC_DEFINE_DIR(moddir   ,moddir,   soundtrack directory)
AC_DEFINE_DIR(nivdir   ,nivdir,   levels directory)
AC_DEFINE_DIR(rscdir   ,rscdir,   resources directory)
AC_DEFINE_DIR(scoresdir,scoresdir,scores directory)
AC_DEFINE_DIR(sfxdir   ,sfxdir,   sound effects directory)
AC_DEFINE_DIR(spritedir,spritedir,sprites directory)
AC_DEFINE_DIR(textdir  ,textdir,  texts directory)
AC_DEFINE_DIR(etcdir   ,etcdir,   config directory)

# ============
# Output files
# ============

AM_CONFIG_HEADER(src/config.h)
AC_OUTPUT(Makefile src/Makefile src/etc/Makefile src/extralvl/Makefile
	src/hedit/Makefile src/intro/Makefile
	src/level/Makefile src/rsc/Makefile src/sprites/Makefile
	src/txt_cfg/Makefile src/mod/Makefile src/sfx/Makefile
	man/Makefile doc/Makefile)

# ====================
# Configuration report
# ====================

eval bindir=$bindir
eval bindir=$bindir
eval datadir=$datadir
eval mandir=$mandir
eval infodir=$infodir

echo "
Heroes configuration
--------------------
Heroes version           : $VERSION
host                     : $host
display & keyboard       : ${display_lib}
joystick                 : ${joystick_lib}
sound                    : ${sound_lib}"
test x$mallocdbg = x || echo "dnl
mem-debug                : ${malloc_lib}"
echo "dnl
compiler                 : $CC
compiler flags           : $CFLAGS
linker flags             : $LDFLAGS $LIBS
binary install path      : $bindir
data install path        : ${datadir}/heroes
manual page install path : $mandir
info manual install path : $infodir"
