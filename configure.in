AC_PREREQ(2.49a)

AC_INIT([Heroes], [0.8a], [heroes-bugs@lists.sourceforge.net])
AC_CONFIG_AUX_DIR(tools)
AC_CONFIG_SRCDIR([src/heroes.c])
AM_INIT_AUTOMAKE([heroes], [0.8a])

AC_COPYRIGHT([Copyright 2000  Alexandre Duret-Lutz])

AC_CANONICAL_HOST
AC_DEFINE_UNQUOTED([HOST],["$host"],[The canonical host])

# ==================
# Supported options.
# ==================

AC_ARG_ENABLE([html-doc],
[AC_HELP_STRING([--enable-html-doc=DIR],
               [build and install html documentation])])
AC_ARG_ENABLE([sound],
[AC_HELP_STRING([--disable-sound],[turn off sound support])])
AC_ARG_ENABLE([debug],
[AC_HELP_STRING([--enable-debug],[turn on debugging])])
AC_ARG_ENABLE([heroes-debug],
[AC_HELP_STRING([--enable-gprof],[turn on profiling])])
AC_ARG_ENABLE([heroes-gprof],
[AC_HELP_STRING([--disable-heroes-debug],[disable tracing facility])])
AC_ARG_ENABLE([mem-debug],
[AC_HELP_STRING([--disable-joystick],[turn off joystick support])])
AC_ARG_WITH([sdl],
[AC_HELP_STRING([--with-sdl=DIR],[root directory of SDL installation])
AC_HELP_STRING([--without-sdl],[disables SDL usage completely])])
AC_ARG_WITH([mikmod],
[AC_HELP_STRING([--with-mikmod=DIR],
               [root directory of libMikMod installation])
AC_HELP_STRING([--without-mikmod],[disables libMikMod usage completely])])

# debugging options

if test "x$enable_debug" = xyes; then
  # disabled by default
  AC_DEFINE([DEBUG],1,[Define if you want debuging code and symbols.])
fi;

if test "x$enable_heroes_debug" != xno; then
  # enabled by default
  AC_DEFINE([USE_HEROES_DEBUG],1,[Define if you want tracing code.])
fi;

# --with-sdl-exec-prefix should imply --with-sdl, and vice-versa

test "${with_sdl_exec_prefix-no}" != no &&
 test "${with_sdl-yes}" = yes && with_sdl="$with_sdl_exec_prefix"

test "${with_sdl-yes}" != yes &&
 test "${with_sdl_exec_prefix-yes}" = yes && with_sdl_exec_prefix="$with_sdl"

# --with-mikmod-exec-prefix should imply --with-mikmod, and vice-versa

test "${with_mikmod_exec_prefix-no}" != no &&
 test "${with_mikmod-yes}" = yes && with_mikmod="$with_mikmod_exec_prefix"

test "${with_mikmod-yes}" != yes &&
 test "${with_mikmod_exec_prefix-yes}" = yes &&
   with_mikmod_exec_prefix="$with_mikmod"

# handle choice between GGI and SDL

if test "${with_GGI-no}" != no; then
  if test "${with_sdl-no}" != no; then
    AC_MSG_ERROR([GGI and SDL can't be both used.])
  fi
  # disable SDL if GGI was selected
  with_sdl=no
else
  if test "${with_sdl-no}" != no; then
    # disable	 GGI if SDL was selected
    with_GGI=no
  fi
fi

# handle choice between SDL_mixer and libMikmod

if test "${with_mikmod-no}" != no; then
  if test "${with_sdl_mixer-no}" != no; then
     AC_MSG_ERROR([libMikMod and SDL_mixer can't be both used.])
  fi
  # disable SDL_mixer if libMikMod was selected
  with_sdl_mixer=no
else
  if test "${with_sdl_mixer-no}" != no; then
    # disable libMikMod if SDL_mixer was selected
    with_mikmod=no
  fi
fi

# SDL_mixer imply SDL

if test "${with_sdl_mixer-no}" != no; then
  if test "${with_GGI-no}" != no; then
    AC_MSG_ERROR([GGI and SDL_mixer can't be both used.])
  fi
  with_GGI=no
fi

# Detect wether CFLAGS and LDFLAGS will be setup by autoconf or not.
test -z "${CFLAGS+set}"  && CFLAGS=  auto_cflags=1
test -z "${LDFLAGS+set}" && LDFLAGS= auto_ldflags=1

# These value will be updated according to detections.
display_lib='<disabled>'
joystick_lib='<disabled>'
sound_lib='<disabled>'
malloc_lib='<disabled>'

# ===================
# Check for programs.
# ===================

AC_PROG_CC
AC_ISC_POSIX
AC_PROG_CC_STDC
AC_PROG_CPP
AC_PROG_AWK
AC_PROG_RANLIB
AC_PROG_LN_S

AM_MISSING_PROG([HELP2MAN], [help2man], [\${SHELL} \${top_srcdir}])
AM_MISSING_PROG([ZIP], [zip], [\${SHELL} \${top_srcdir}])
AM_MISSING_PROG([UNZIP], [unzip], [\${SHELL} \${top_srcdir}])

AC_PATH_PROG([GPERF], [gperf])
AM_CONDITIONAL(HAVE_GPERF, [test \! -z "$GPERF"])

AC_CACHE_SAVE

# =====================
# Checks for libraries.
# =====================

# ==============
# Check for GGI.
# ==============

# Provide a config.h help string, as AC_caolan_CHECK_PACKAGE does not.
AH_TEMPLATE([HAVE_PKG_GGI],[Define if you have libggi.])

if test "${with_GGI-yes}" != no; then

AC_caolan_CHECK_PACKAGE(GGI,[ggiOpen],[ggi],[ggi/ggi.h],,[with_GGI=no])

fi
if test "${with_GGI-yes}" != no; then

AC_adl_FIND_HEADER([ggi/keyboard.h],,
 [/usr/include/ggi/keyboard.h] dnl
 [${GGI_include-/usr/local/include}/ggi/keyboard.h],
 [#[ 	]*define[ 	][ 	]*GIIUC*],7,,
 [AC_MSG_ERROR([Keysyms macros not found: where is GGI installed?])])

GGI_KEYBOARD_H="$ac_cv_header_path_ggi_keyboard_h"
AC_SUBST([GGI_KEYBOARD_H])

with_sdl=no
display_lib=LibGGI
fi

# ==================
# Check for lib SDL.
# ==================

if test "${with_sdl-yes}" != no; then

AC_adl_PKG_GENERIC(sdl,[1.0.1],[SDL_Init],
[AC_DEFINE([HAVE_SDL],1,[Define if you have the SDL library.])],
[with_sdl=no])

fi
if test "${with_sdl-yes}" != no; then

AC_adl_FIND_HEADER([SDL_keysym.h],[$SDL_CFLAGS],
 [/usr/include/SDL/SDL_keysym.h] dnl
 [/usr/local/include/SDL/SDL_keysym.h],
 [#[ 	]*define[ 	][ 	]*SDLK_*],7,,
 [AC_MSG_ERROR([Keysyms definitions not found: where is SDL installed?])])

SDL_KEYSYM_H="$ac_cv_header_path_SDL_keysym_h"
AC_SUBST([SDL_KEYSYM_H])

display_lib="SDL dnl
$sdl_config_major_version.$sdl_config_minor_version.$sdl_config_micro_version"
AC_CHECK_FUNCS([SDL_EnableKeyRepeat])
fi

# ================================================
# Check that either LibGGI or SDL have been found.
# ================================================

if test x${with_sdl} = xno && test x${with_GGI} = xno; then
  AC_MSG_ERROR([Heroes can't compile without a graphic library.

Heroes requires either GGI or SDL to be installed on your system.
See the README file for pointers towards those libraries.
])
fi
AM_CONDITIONAL(GGI, [test "x${with_GGI}" != xno])
AM_CONDITIONAL(SDL, [test "x${with_sdl}" != xno])

# =================
# Joystick support.
# =================

# Provide a config.h help string, as AC_caolan_CHECK_PACKAGE does not.
AH_TEMPLATE([HAVE_PKG_GII],[Define if you have libgii.])

if test "${enable_joystick-yes}" = yes; then

  # -- check for Joystick support in SDL

  sdl_joystick=no
  if test "${with_sdl-yes}" != no && test "${with_GII-no}" = no;  then
    AC_CHECK_FUNCS([SDL_JoystickOpen],[
sdl_joystick=yes
joystick_lib="SDL dnl
$sdl_config_major_version.$sdl_config_minor_version.$sdl_config_micro_version"
])
  fi

  # -- check for LibGGI (another way to get joystick support)

  gii_joystick=no
  if test $sdl_joystick = no && test "${with_GII-yes}" != no;  then
    AC_caolan_CHECK_PACKAGE([GII],[giiOpen],[gii],[ggi/gii.h],[
gii_joystick=yes
joystick_lib='LibGII'
])
  fi

  if test $sdl_joystick = no && test $gii_joystick = no; then
    enable_joystick=no
  fi
fi

if test "${enable_joystick-yes}" = yes; then
  AC_DEFINE([JOYSTICK_SUPPORT],1,[Define if you want joystick support.])
fi

# ===================
# Check for lib math.
# ===================

AC_CHECK_LIB([m],[sin])

# ==========================
# Check for sound libraries.
# ==========================

if test "${enable_sound-yes}" != no; then

# ====================
# Check for SDL_mixer.
# ====================

# Provide a config.h help string, as AC_caolan_CHECK_PACKAGE does not.
AH_TEMPLATE([HAVE_PKG_sdl_mixer],[Define if you have libSDL_mixer.])

if test "${with_sdl-yes}" != no && test "${with_sdl_mixer-yes}" != no; then

# temporaly put the CFLAGS for SDL in CPPFLAGS
# so that AC_caolan_CHECK_PACKAGE can find SDL_mixer.h in the same directory.
tmp_CPPFLAGS="$CPPFLAGS"
CPPFLAGS="$SDL_CFLAGS $CPPFLAGS"

AC_caolan_CHECK_PACKAGE([sdl_mixer],[Mix_OpenAudio],[SDL_mixer],[SDL_mixer.h],,
[with_sdl_mixer=no])
if test "x${with_sdl_mixer}" != xno; then
  sound_lib="SDL_mixer"
  with_sdl_mixer=yes
  with_mikmod=no
fi

# revert old value
CPPFLAGS="$tmp_CPPFLAGS"

fi # with_sdl_mixer

# ====================
# Check for LibMikMod.
# ====================

if test "${with_mikmod-yes}" != no; then

AC_adl_PKG_GENERIC([libmikmod],[3.1.7],[MikMod_Init],
[sound_lib="libmikmod dnl
$libmikmod_config_major_version.$libmikmod_config_minor_version.dnl
$libmikmod_config_micro_version"
]AC_DEFINE([HAVE_LIBMIKMOD],1,[Define if you have the LibMikMod library.]))

fi

fi # enable_sound

# ================================
# Check for any malloc() debugger.
# ================================

adl_WITH_DMALLOC
adl_WITH_EFENCE
adl_ENABLE_MEM_DEBUG

# ==============================================
# Now that we have all the libraries, check that
# compiled programs are still runnable.
# ==============================================

adl_RUN_CHECK

# ========================
# Checks for header files.
# ========================

AC_HEADER_STDC
AC_HEADER_DIRENT
AC_CHECK_HEADERS(
 [direct.h] dnl
 [io.h] dnl
 [memory.h] dnl
 [stdbool.h] dnl
 [stdint.h] dnl
 [string.h] dnl
 [strings.h] dnl
 [stdlib.h] dnl
 [sys/time.h] dnl
 [unistd.h] dnl
 [windows.h] dnl
)
AC_HEADER_TIME
AC_HEADER_STAT

# ==============================================================
# Checks for typedefs, structures, and compiler characteristics.
# ==============================================================

AM_C_PROTOTYPES
AC_C_CONST

# =============================
# Checks for library functions.
# =============================

AC_CHECK_DECLS([malloc, realloc, calloc, free])
AC_CHECK_FUNCS([gettimeofday memcpy sleep])

adl_FUNC_READDIR

AC_FUNC_VPRINTF
AC_FUNC_MKDIR

AC_REPLACE_FUNCS([strcasecmp])
jm_FUNC_MALLOC

# KLUDGE: clear LIBS to work around a bug (?) on alphaev56-dec-osf4.0d
# where conftest never exit when linked with `-lgii' or `-lggi'.
old_libs="$LIBS"
LIBS=''
jm_FUNC_REALLOC
LIBS="$old_libs"

# for error.c
AC_CHECK_FUNCS([strerror])
AC_FUNC_STRERROR_R

adl_FUNC_GETOPT_LONG

AC_SUBST([LIBOBJS])

# ====================
# Check for endianess.
# ====================

AC_C_BIGENDIAN_CROSS

# =====================
# Internationalization.
# =====================

ALL_LINGUAS="fr"
AM_GNU_GETTEXT

# =============================================================
# Setup the correct compiler options whether the
# user enabled debug or not.  (Adapted from Zsh's configure.in)
# =============================================================

if test "x${enable_debug}" != xyes && test -n "$GCC"; then
  CFLAGS="$CFLAGS -DNDEBUG"
fi

dnl This needs to be moved in a macro.
dnl ----------------------------------
if test -n "$auto_cflags"; then
  if test "x${enable_debug}" = xyes; then
    # --enable-debug imply --enable-warnings, unless specified otherwise
    if test "x$enable_warnings" != xno; then
      enable_warnings=yes
    fi

    if test -n "$GCC"; then
      CFLAGS="$CFLAGS -ggdb"
    else
      CFLAGS="$CFLAGS -g"
    fi
  else
    ADL_GCC_OPTIM
  fi
  if test "x${enable_gprof}" = xyes; then
    if test -n "$GCC"; then
      CFLAGS="`echo \"$CFLAGS -pg\" | sed 's/-fomit-frame-pointer/-g/'`"
    fi
  fi
fi
# keep the symbol if --enable-debug or --enable-gprof,
# strip the binary otherwise.
if test -n "$auto_ldflags"; then
  case "${enable_debug}${enable_gprof}:$host_os" in
    *yes*:aix*|*yes*:hpux*|*yes*:netbsd*)
      ;;  # "ld -g" is not valid on these systems
    *yes*:*)
      LDFLAGS="$LDFLAGS -g" ;;
    *)
      LDFLAGS="$LDFLAGS -s" ;;
  esac
fi

ad_GCC_WARNINGS

# =========================
# Directories configuration
# =========================

data_dir=${datadir}/heroes
AC_DEFINE_DIR([datadir],[data_dir],[Path to the data directory.])

# ===================
# HTML documentation.
# ===================

# disabled by default
if test "${enable_html_doc-no}" != no; then
  if test "x$enable_html_doc" = xyes; then
    htmldir="$data_dir/doc"
  else
    htmldir="$enable_html_doc"
  fi
  AC_SUBST([htmldir])
else
  htmldir='\<none\>'
fi
AM_CONDITIONAL(MAKE_HTML, [test "${enable_html_doc-no}" != no])

# ============
# Output files
# ============

# Put config.h in the base directory because libintl expects it here,
# but keep src/config.h.in in the src/ directory to keep the base directory
# as clean as possible.
dnl Don't quote the following argument, it is parsed by automake.
AM_CONFIG_HEADER(config.h:src/config.h.in)

AC_CONFIG_FILES([
 Makefile
 arch/Makefile
 doc/Makefile
 intl/Makefile
 lib/Makefile
 m4/Makefile
 man/Makefile
 po/Makefile.in
 src/Makefile
 src/etc/Makefile
 tools/Makefile
])
AC_OUTPUT

# ====================
# Configuration report
# ====================

eval bindir="$bindir"
eval bindir="$bindir"
eval datadir="$datadir"
eval mandir="$mandir"
eval infodir="$infodir"
eval htmldir="$htmldir"

echo "
Heroes configuration
--------------------
Heroes version           : $VERSION
host                     : $host
display & keyboard       : ${display_lib}
joystick                 : ${joystick_lib}
sound                    : ${sound_lib}
compiler                 : $CC
compiler flags           : $CFLAGS
linker flags             : $LDFLAGS $LIBS
binary install path      : $bindir
data install path        : ${datadir}/heroes
manual page install path : $mandir
info manual install path : $infodir
html doc install path    : $htmldir"
