#: src/argv.c:152
msgid ""
"Heroes is a game similar to the \"Tron\" and \"Nibbles\" games of yore\n"
"but includes many graphical improvements and new game features.\n"
msgstr ""
"Heroes es un juego similar a los antaños juegos \"Tron\" y \"Nibbles\" pero\n"
"incluye muchas mejoras gráficas y nuevas características.\n"

#: src/argv.c:155 src/heroeslvl.c:81
msgid ""
"Mandatory arguments to long options are mandatory for short options too.\n"
msgstr ""
"Los argumentos que son obligatorios para las opciones largas son también\n"
"obligatorios para las opciones cortas.\n"

#: src/argv.c:157
msgid ""
"General options:\n"
"  -v, --version               display version number\n"
"  -h, --help                  display this help\n"
"  -q, --quiet                 don't print warning messages\n"
"  -Q, --really-quiet          don't even print error messages\n"
"  -v, --verbose=CHANNELS      enable or disable debugging channels\n"
"                                (see --list=debug for available channels)\n"
"  -l, --list=WORD             show some internal information; WORD can be\n"
"                                'debug', 'resources', 'sound-drivers' or\n"
"                                'sound-tracks'\n"
msgstr ""
"Opciones generales:\n"
"  -v, --version               muestra el número de versión\n"
"  -h, --help                  muestra esta ayuda\n"
"  -q, --quiet                 no muestra mensajes de advertencia\n"
"  -Q, --really-quiet          no muestra siquiera los mensajes de error\n"
"  -v, --verbose=CANALES       habilita o deshabilita los canales de\n"
"                                depuración (utilice --list=debug para\n"
"                                obtener una lista de canales disponibles)\n"
"  -l, --list=PALABRA          muestra alguna información interna; PALABRA\n"
"                                puede ser `debug', `resources',\n"
"                                `sound-drivers' o `sound-tracks'\n"

#: src/argv.c:168
msgid ""
"Sound options:\n"
"  -d, --driver=N[,OPTIONS]    use Nth driver for sound output (0:"
"autodetect)\n"
"                                (see --list=sound-drivers for available Ns)\n"
"  -S, --no-sound              disable sound\n"
"  -X, --no-sfx                disable sound-effects\n"
"  -m, --mono                  non-stereo output\n"
"  -8, --8bits                 8bits sound output\n"
"  -i, --high-quality          high quality mixer\n"
msgstr ""
"Opciones de sonido:\n"
"  -d, --driver=N[,OPCIONES]   utiliza el controlador N para la salida de\n"
"                                audio (0 = autodetección)\n"
"                                (utilice --list=sound-drivers para obtener\n"
"                                una lista de N's disponibles)\n"
"  -S, --no-sound              deshabilita el sonido\n"
"  -X, --no-sfx                deshabilita los efectos de sonido\n"
"  -m, --mono                  salida no estéreo\n"
"  -8, --8bits                 salida de audio de 8 bits\n"
"  -i, --high-quality          mezclador de alta calidad\n"

#: src/argv.c:177
msgid ""
"Display options:\n"
"  -G, --gfx-options=OPTIONS   pass OPTIONS to the display driver\n"
"  -F, --full-screen           full screen mode\n"
"  -2, --double                stretch the display twofold\n"
"  -3, --triple                stretch the display threefold\n"
"  -4, --quadruple             stretch the display fourfold\n"
"  -e, --even-lines            display only even-lines\n"
msgstr ""
"Opciones de pantalla:\n"
"  -G, --gfx-options=OPCIONES  pasa OPCIONES al controlador de pantalla\n"
"  -F, --full-screen           modo pantalla completa\n"
"  -2, --double                estira la pantalla al doble\n"
"  -3, --triple                estira la pantalla al triple\n"
"  -4, --quadruple             estira la pantalla al cuádruple\n"
"  -e, --even-lines            muestra sólo las líneas pares\n"

#. TRANS: rotozoom is a graphical effect used in the demo of yore
#. where the screen rotate and zoom (actually it doesn't zoom in Heroes);
#. waves is another effect where the screen is agitated like some
#. jelly (this was also called the `mushroom effect' in game like
#. Death Rally).
#: src/argv.c:190
msgid ""
"Miscellaneous options:\n"
"      --cpu-off               disable computer opponents\n"
"      --default-scores        restore default scores file\n"
"      --default-options       restore default options file\n"
"      --default-saves         restore default saves file\n"
"  -s, --swap-sides            swap sides in two player mode\n"
"      --no-double-fx          disable combination of rotozoom and waves\n"
"  -g, --go                    skip the introduction\n"
"  -J, --no-joystick           disable joystick handling\n"
msgstr ""
"Opciones misceláneas:\n"
"      --cpu-off               deshabilita los oponentes manejados por la CPU\n"
"      --default-scores        restaura el archivo de puntuaciones\n"
"                                predeterminado\n"
"      --default-options       restaura el archivo de opciones predeterminado\n"
"      --default-saves         restaura el archivo de juegos guardados\n"
"                                predeterminado\n"
"  -s, --swap-sides            intercambia los lados en el modo dos jugadores\n"
"      --no-double-fx          deshabilita la combinación de rotozoom y ondas\n"
"  -g, --go                    no muestra la introducción\n"
"  -J, --no-joystick           deshabilita el manejo del joystick\n"

#: src/argv.c:200
msgid "  -p, --plug-in=NAME\t      load plug-in NAME\n"
msgstr "  -p, --plug-in=NOMBRE        carga el plug-in NOMBRE\n"

#: src/argv.c:202
msgid ""
"These options can be set in your file ~/.heroes/heroesrc (which is read\n"
"before parsing other command line options) using a line like the following:\n"
"\n"
"  Options: -gs -d3,buffer=11,count=4\n"
msgstr ""
"Estas opciones pueden ser puestas en su archivo ~/.heroes/heroesrc (que es\n"
"leído antes de analizar otras opciones desde la línea de comandos)\n"
"utilizando una línea como la siguiente:\n"
"\n"
"  Options: -gs -d3,buffer=11,count=4\n"

