#: src/heroeslvl.c:80
msgid "Heroeslvl is a tool used to inspect Heroes' level files.\n"
msgstr ""
"Heroeslvl es una herramienta para inspeccionar los archivos de\n"
"niveles de Heroes.\n"

#: src/heroeslvl.c:83
msgid "  -v, --version               display version number"
msgstr "  -v, --version               muestra el número de versión"

#: src/heroeslvl.c:85
msgid "  -h, --help                  display this help"
msgstr "  -h, --help                  muestra esta ayuda"

#: src/heroeslvl.c:87
msgid ""
"  -p, --print=WHAT            select information to display.  WHAT should "
"be\n"
"                                one or more of these characters:"
msgstr ""
"  -p, --print=QUE             selecciona información para mostrar.  QUE "
"debería\n"
"                                ser uno o más de estos caracteres:"


#: src/heroeslvl.c:90
msgid "d   print square directions"
msgstr "d   muestra direcciones"

