msgid "%s:%d: unknown keyword `%s'"
msgstr "%s:%d: parola chiave sconosciuta `%s'"

#: src/media/sfx.c:95
#, c-format
msgid ""
"Cannot open %s, disabling sound-effects\n"
"(run with -X to supress this message)."
msgstr ""
"Impossibile aprire %s, disabilito gli effetti sonori\n"
"(esegui con l'opzione -X per eliminare questo messaggio)."

#: src/media/sfx.c:261
#, c-format
msgid "Unable to load sample %s"
msgstr "Impossibile caricare l'esempio %s"

#: src/media/dummy/strack.c:76
msgid "Heroes has been compiled without sound support."
msgstr "Heroes è stato compilato senza il supporto audio."

#. FIXME: ask to send a bug report with a trace
#: src/media/ggi/video.c:155
msgid "failed to get any direct buffer for this visual"
msgstr "impossibile ottenere un buffer diretto per questo schermo"

#. TRANS: a `visual' is associated by LibGGI to a display.  You can
#. actually call it a `display', this makes no big difference.
#: src/media/ggi/video.c:177
msgid "failed to open visual."
msgstr "impossibile aprire lo schermo."

#: src/media/ggi/video.c:185
msgid "cannot setup a correct display."
msgstr "impossibile impostare uno schermo corretto."

#: src/media/ggi/video.c:192
#, c-format
msgid "negociated video mode is too small (width=%d, height=%d)"
msgstr "il modo video negoziato è troppo piccolo (ampiezza=%d, larghezza=%d)"

#. TRANS: `display-memory' is the name of a LibGGI driver and
#. make no sense to translate.
#: src/media/ggi/video.c:205
msgid "Failed to open an internal `display-memory' visual."
msgstr "Impossibile aprire un `display-memory' interno."

#: src/media/ggi/video.c:207
msgid "Failed to set 320x200x8 mode on display-memory"
msgstr "Impossibile impostare il modo 320x200x8 su `display-memory'"

#: src/media/ggi/video.c:284
msgid "failed to acquire direct-buffer"
msgstr "impossibile acquisire il buffer diretto"

#: src/media/ggi/video.c:301
msgid "failed to release direct-buffer"
msgstr "impossibile rilasciare il buffer diretto"

#: src/media/gii/joystick.c:97
#, c-format
msgid "unexpected event %d\n"
msgstr "evento inaspettato %d\n"

#: src/media/gii/joystick.c:110 src/media/sdl/joystick.c:51
msgid "No joystick found (run with `-J' to suppress this message)."
msgstr ""
"Joystick non trovato (esegui con l'opzione `-J' per eliminare questo "
"messaggio)."

#: src/media/mikmod/strack.c:104
#, c-format
msgid ""
"Could not initialize sound, reason: %s\n"
"Disabling sound output (use -S to suppress this message)."
msgstr ""
"Impossibile inizializzare il sonoro, ragione: %s\n"
"Disabilto l'output sonoro (usa -S per eliminare questo messaggio)."

#: src/media/mikmod/strack.c:114
msgid ""
"Could not initialize sound, reason: LibMikMod is not thread safe.\n"
"Disabling sound output (use -S to suppress this message)."
msgstr ""
"Impossibile inizilizzare il sonoro, ragione: LibMikMod non è tread safe.\n"
"Disabilito l'uotput sonoro (usa -S per eliminare questo messaggio)."

#: src/media/mikmod/strack.c:149 src/media/sdl_mixer/strack.c:134
#, c-format
msgid "Could not load %s, reason: %s"
msgstr "Impossibile caricare %s, ragione: %s"

#: src/media/mikmod/strack.c:214
#, c-format
msgid "LibMikMod version %ld.%ld.%ld\n"
msgstr "LibMikMod versione %ld.%ld.%ld\n"

#: src/media/mikmod/strack.c:217
#, c-format
msgid ""
"\n"
"Available drivers:\n"
"%s\n"
msgstr ""
"\n"
"Driver disponibili:\n"
"%s\n"

#: src/media/mikmod/strack.c:233
#, c-format
msgid ""
"Argument '%s' out of bounds, must be between %d and %d.\n"
"Use '%s --help' for more information."
msgstr ""
"Argomento '%s' fuori scala, deve essere fra %d e %d.\n"
"Usa '%s --help' per ulteriori informazioni."

#: src/media/sdl/video.c:98
#, c-format
msgid "Failed to open visual: %s"
msgstr "Impossibile aprire lo schermo: %s"

#: src/media/sdl_mixer/strack.c:96
#, c-format
msgid ""
"Couldn't open audio: %s\n"
"Disabling sound output (use -S to suppress this message)."
msgstr ""
"Impossibile usare l'audio: %s\n"
"Disabilito l'output sonoro (usa -S per eliminare questo messaggio)."

#: src/media/sdl_mixer/strack.c:172
msgid ""
"Heroes has been compiled with SDL_mixer, there is no driver list available."
msgstr ""
"Heroes è stato compilato con SDL_mixer, non c'è un elenco dei driver "
"disponibile."

#: src/media/sdl_mixer/strack.c:188
#, c-format
msgid "%s: missing parameter for 'freq'"
msgstr "%s: parametro mancante per `freq'"

#: src/media/sdl_mixer/strack.c:194
#, c-format
msgid "%s: missing parameter for `buffers'"
msgstr "%s: parametro mancante per `buffers'"

#: src/media/sdl_mixer/strack.c:196
#, c-format
msgid "%s: recognized sound options are freq=nnn and buffers=nnn"
msgstr "%s: le opzioni sonore riconosciute sono freq=nnn e buffers=nnn"

